<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">Aplikasi Target</h1>
    <p class="text-muted mb-0">Aplikasi Laravel tujuan pengiriman data absensi.</p>
  </div>
  <a href="/admin/apps/create" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i> Tambah Aplikasi
  </a>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="GET" action="/admin/apps" class="row g-2 align-items-end">
      <div class="col-md-6">
        <label class="form-label small mb-1">Cari</label>
        <input type="text" name="search" class="form-control form-control-sm"
               value="<%= filters.search %>" placeholder="Nama aplikasi atau URL">
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Status</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">Semua</option>
          <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
          <option value="INACTIVE" <%= filters.status === 'INACTIVE' ? 'selected' : '' %>>INACTIVE</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-secondary btn-sm w-100">
          <i class="bi bi-search me-1"></i> Filter
        </button>
        <a href="/admin/apps" class="btn btn-outline-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Nama Aplikasi</th>
          <th>Webhook URL</th>
          <th>Secret Key</th>
          <th>Status</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">Belum ada aplikasi target.</td></tr>
        <% } %>
        <% rows.forEach((app) => { %>
          <tr>
            <td><%= app.id %></td>
            <td class="fw-semibold"><%= app.app_name %></td>
            <td class="small"><code class="text-break"><%= app.webhook_url %></code></td>
            <td class="small">
              <code title="<%= app.secret_key %>"><%= app.secret_key.slice(0, 8) %>&hellip;</code>
            </td>
            <td>
              <span class="badge text-bg-<%= app.status === 'ACTIVE' ? 'success' : 'secondary' %>">
                <%= app.status %>
              </span>
            </td>
            <td class="text-end text-nowrap">
              <a href="/admin/apps/<%= app.id %>/edit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-pencil"></i>
              </a>
              <form method="POST" action="/admin/apps/<%= app.id %>/regenerate-secret" class="d-inline"
                    data-confirm="Regenerasi secret key untuk <%= app.app_name %>? Integrasi lama akan gagal sampai diperbarui.">
                <button type="submit" class="btn btn-sm btn-outline-warning" title="Regenerasi secret">
                  <i class="bi bi-arrow-repeat"></i>
                </button>
              </form>
              <form method="POST" action="/admin/apps/<%= app.id %>?_method=DELETE" class="d-inline"
                    data-confirm="Hapus aplikasi <%= app.app_name %>? Mapping terkait akan terhapus.">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <div class="card-body pt-0">
    <%- include('../partials/pagination') %>
  </div>
</div>

<%- include('../partials/footer') %>
