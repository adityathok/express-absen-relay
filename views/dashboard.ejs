<%- include('partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">Ringkasan penerimaan push absensi dan status pengiriman ke aplikasi Laravel.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/attendance-logs" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-list-check me-1"></i> Log Absensi
    </a>
    <a href="/admin/forward-logs" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-send me-1"></i> Log Pengiriman
    </a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-muted small text-uppercase">Hit Hari Ini</div>
            <div class="display-6 fw-semibold"><%= attendanceStats.total_today %></div>
          </div>
          <span class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-fingerprint"></i></span>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-muted small text-uppercase">Mesin Aktif</div>
            <div class="display-6 fw-semibold"><%= activeDevices %></div>
            <div class="small text-muted">dari <%= totalDevices %> mesin</div>
          </div>
          <span class="stat-icon bg-success-subtle text-success"><i class="bi bi-hdd-network"></i></span>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-muted small text-uppercase">Aplikasi Target</div>
            <div class="display-6 fw-semibold"><%= totalApps %></div>
            <div class="small text-muted">aplikasi Laravel</div>
          </div>
          <span class="stat-icon bg-info-subtle text-info"><i class="bi bi-box-seam"></i></span>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-muted small text-uppercase">Mapping</div>
            <div class="display-6 fw-semibold"><%= totalMappings %></div>
            <div class="small text-muted">routing device &rarr; app</div>
          </div>
          <span class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-diagram-3"></i></span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-semibold">
        <i class="bi bi-activity me-1"></i> Status Forward Hari Ini
      </div>
      <div class="card-body">
        <% const total = Math.max(1, attendanceStats.total_today); %>
        <div class="progress mb-3" style="height: 22px;">
          <div class="progress-bar bg-success" style="width: <%= (attendanceStats.success_today / total) * 100 %>%"
               title="Success"></div>
          <div class="progress-bar bg-info" style="width: <%= (attendanceStats.partial_today / total) * 100 %>%"
               title="Partial"></div>
          <div class="progress-bar bg-warning" style="width: <%= (attendanceStats.pending_today / total) * 100 %>%"
               title="Pending"></div>
          <div class="progress-bar bg-danger" style="width: <%= (attendanceStats.failed_today / total) * 100 %>%"
               title="Failed"></div>
        </div>
        <div class="row text-center g-2">
          <div class="col-6 col-md-3">
            <div class="border rounded py-2">
              <div class="fs-5 fw-semibold text-success"><%= attendanceStats.success_today %></div>
              <div class="small text-muted">Success</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="border rounded py-2">
              <div class="fs-5 fw-semibold text-info"><%= attendanceStats.partial_today %></div>
              <div class="small text-muted">Partial</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="border rounded py-2">
              <div class="fs-5 fw-semibold text-warning"><%= attendanceStats.pending_today %></div>
              <div class="small text-muted">Pending</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="border rounded py-2">
              <div class="fs-5 fw-semibold text-danger"><%= attendanceStats.failed_today %></div>
              <div class="small text-muted">Failed</div>
            </div>
          </div>
        </div>

        <hr>
        <div class="d-flex justify-content-between small">
          <span class="text-muted">Total pengiriman tercatat</span>
          <span class="fw-semibold">
            <span class="text-success"><%= forwardStats.success %></span> /
            <span class="text-warning"><%= forwardStats.pending %></span> /
            <span class="text-danger"><%= forwardStats.failed %></span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-broadcast me-1"></i> Log Absensi Terbaru</span>
        <span class="badge text-bg-light border">live</span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Mesin</th>
              <th>User</th>
              <th>Waktu Absen</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="attendance-feed">
            <% if (!latestLogs.length) { %>
              <tr id="feed-empty">
                <td colspan="5" class="text-center text-muted py-4">
                  Belum ada log absensi diterima.
                </td>
              </tr>
            <% } %>
            <% latestLogs.forEach((log) => { %>
              <tr data-log-id="<%= log.id %>">
                <td><a href="/admin/attendance-logs/<%= log.id %>">#<%= log.id %></a></td>
                <td><code><%= log.device_sn %></code></td>
                <td><%= log.user_id_finger %></td>
                <td class="small"><%= log.timestamp %></td>
                <td><%- include('partials/status', { status: log.forward_status }) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
