<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span class="text-muted small">
      Halaman <%= page %> dari <%= totalPages %> &middot; total <%= total %> data
    </span>
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= hasPrev ? '' : 'disabled' %>">
        <a class="page-link" href="<%= hasPrev ? buildPageUrl(page - 1) : '#' %>">&laquo;</a>
      </li>
      <% const start = Math.max(1, page - 2); const end = Math.min(totalPages, page + 2); %>
      <% for (let p = start; p <= end; p++) { %>
        <li class="page-item <%= p === page ? 'active' : '' %>">
          <a class="page-link" href="<%= buildPageUrl(p) %>"><%= p %></a>
        </li>
      <% } %>
      <li class="page-item <%= hasNext ? '' : 'disabled' %>">
        <a class="page-link" href="<%= hasNext ? buildPageUrl(page + 1) : '#' %>">&raquo;</a>
      </li>
    </ul>
  </nav>
<% } %>
