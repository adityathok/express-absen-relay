<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> &middot; Fingerprint Relay</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-body-tertiary">
<% const isActive = (key) => (typeof active !== 'undefined' && active === key); %>

<aside class="app-sidebar" id="appSidebar">
  <a class="app-sidebar-brand" href="/admin">
    <i class="bi bi-fingerprint"></i>
    <span>Fingerprint Relay</span>
  </a>

  <nav class="app-sidebar-nav">
    <div class="app-nav-section">Menu</div>
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link <%= isActive('dashboard') ? 'active' : '' %>" href="/admin">
          <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= isActive('devices') ? 'active' : '' %>" href="/admin/devices">
          <i class="bi bi-hdd-network"></i><span>Mesin</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= isActive('apps') ? 'active' : '' %>" href="/admin/apps">
          <i class="bi bi-box-seam"></i><span>Aplikasi</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= isActive('mappings') ? 'active' : '' %>" href="/admin/mappings">
          <i class="bi bi-diagram-3"></i><span>Mapping</span>
        </a>
      </li>
    </ul>

    <div class="app-nav-section">Monitoring</div>
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link <%= isActive('logs-attendance') ? 'active' : '' %>" href="/admin/attendance-logs">
          <i class="bi bi-journal-text"></i><span>Log Absensi</span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= isActive('logs-forward') ? 'active' : '' %>" href="/admin/forward-logs">
          <i class="bi bi-send"></i><span>Log Pengiriman</span>
        </a>
      </li>
    </ul>
  </nav>

  <div class="app-sidebar-footer">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="dropdown">
        <button class="btn btn-sm w-100 d-flex align-items-center gap-2 sidebar-user" data-bs-toggle="dropdown">
          <i class="bi bi-person-circle fs-5"></i>
          <span class="text-truncate"><%= currentUser.username %></span>
          <i class="bi bi-chevron-up ms-auto small"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-dark w-100">
          <li>
            <form method="POST" action="/logout">
              <button type="submit" class="dropdown-item text-danger">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
              </button>
            </form>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</aside>

<div class="app-sidebar-backdrop" id="appSidebarBackdrop"></div>

<div class="app-main">
  <header class="app-topbar">
    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="appSidebarToggle" aria-label="Buka menu">
      <i class="bi bi-list fs-5"></i>
    </button>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <span class="badge text-bg-secondary">
        <i class="bi bi-broadcast me-1"></i><span id="socket-status">connecting</span>
      </span>
    </div>
  </header>

  <main class="app-content">
    <%- include('flash') %>
