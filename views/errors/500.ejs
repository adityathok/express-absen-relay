<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof status !== 'undefined' ? status : 500 %> &middot; Fingerprint Relay</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-body-tertiary d-flex align-items-center py-5">
  <main class="container text-center" style="max-width: 600px;">
    <div class="display-1 fw-bold text-danger"><%= typeof status !== 'undefined' ? status : 500 %></div>
    <h1 class="h4"><%= typeof title !== 'undefined' ? title : 'Terjadi Kesalahan' %></h1>
    <p class="text-muted"><%= typeof message !== 'undefined' ? message : 'Terjadi kesalahan pada server.' %></p>
    <a href="/admin" class="btn btn-primary"><i class="bi bi-house me-1"></i> Kembali ke Dashboard</a>
  </main>
</body>
</html>
