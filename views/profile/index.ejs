<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">Profil Saya</h1>
    <p class="text-muted mb-0">Kelola username dan password akun dashboard Anda.</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link <%= openTab === 'profile' ? 'active' : '' %>"
                data-bs-toggle="tab" data-bs-target="#profile-pane" type="button" role="tab">
          <i class="bi bi-person me-1"></i> Profil
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link <%= openTab === 'password' ? 'active' : '' %>"
                data-bs-toggle="tab" data-bs-target="#password-pane" type="button" role="tab">
          <i class="bi bi-shield-lock me-1"></i> Password
        </button>
      </li>
    </ul>

    <div class="tab-content card border-0 shadow-sm">
      <div class="tab-pane fade <%= openTab === 'profile' ? 'show active' : '' %>" id="profile-pane" role="tabpanel">
        <div class="card-body">
          <% if (profileErrors.length) { %>
            <div class="alert alert-danger">
              <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Periksa kembali input:</div>
              <ul class="mb-0 small">
                <% profileErrors.forEach((error) => { %><li><%= error %></li><% }); %>
              </ul>
            </div>
          <% } %>

          <form method="POST" action="/admin/profile?_method=PUT">
            <div class="mb-3">
              <label class="form-label">Username <span class="text-danger">*</span></label>
              <input type="text" name="username" class="form-control" value="<%= form.username || '' %>"
                     minlength="3" maxlength="50" required autocomplete="username"
                     placeholder="cth: admin">
              <div class="form-text">Minimal 3 karakter. Hanya huruf, angka, titik, underscore, dan strip.</div>
            </div>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i> Simpan Profil
            </button>
          </form>
        </div>
      </div>

      <div class="tab-pane fade <%= openTab === 'password' ? 'show active' : '' %>" id="password-pane" role="tabpanel">
        <div class="card-body">
          <% if (passwordErrors.length) { %>
            <div class="alert alert-danger">
              <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Periksa kembali input:</div>
              <ul class="mb-0 small">
                <% passwordErrors.forEach((error) => { %><li><%= error %></li><% }); %>
              </ul>
            </div>
          <% } %>

          <form method="POST" action="/admin/profile/password?_method=PUT">
            <div class="mb-3">
              <label class="form-label">Password Saat Ini <span class="text-danger">*</span></label>
              <input type="password" name="current_password" class="form-control"
                     required autocomplete="current-password" placeholder="Masukkan password lama">
            </div>
            <div class="mb-3">
              <label class="form-label">Password Baru <span class="text-danger">*</span></label>
              <input type="password" name="new_password" class="form-control"
                     minlength="8" maxlength="100" required autocomplete="new-password"
                     placeholder="Minimal 8 karakter">
            </div>
            <div class="mb-3">
              <label class="form-label">Konfirmasi Password Baru <span class="text-danger">*</span></label>
              <input type="password" name="confirm_password" class="form-control"
                     minlength="8" maxlength="100" required autocomplete="new-password"
                     placeholder="Ulangi password baru">
            </div>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-shield-check me-1"></i> Ubah Password
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">
        <i class="bi bi-person-badge me-1"></i> Informasi Akun
      </div>
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <i class="bi bi-person-circle display-5 text-primary"></i>
          <div>
            <div class="fw-semibold"><%= user.username %></div>
            <div class="text-muted small">Administrator</div>
          </div>
        </div>
        <dl class="row mb-0 small">
          <dt class="col-5 text-muted">User ID</dt>
          <dd class="col-7"><%= user.id %></dd>
          <dt class="col-5 text-muted">Terdaftar</dt>
          <dd class="col-7"><%= user.created_at %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
