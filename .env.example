# Application
NODE_ENV=development
PORT=3331
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=express_absen_relay
DB_POOL_LIMIT=10

# Default dashboard admin (used by `npm run setup` only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Relay / webhook forwarding
RELAY_TIMEOUT_MS=10000
RELAY_MAX_RETRY=5
RELAY_RETRY_INTERVAL_SECONDS=60
RELAY_RETRY_CRON=* * * * *
